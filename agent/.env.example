# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Google Gemini (for voice model)
GOOGLE_API_KEY=your_google_api_key

# Shopify Store
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_your_token

# Shopify Catalog MCP (optional — enables global cross-merchant search)
SHOPIFY_CATALOG_CLIENT_ID=your_catalog_client_id
SHOPIFY_CATALOG_CLIENT_SECRET=your_catalog_client_secret
