# Gemini API (for text chat fallback)
GEMINI_API_KEY=your_gemini_api_key

# LiveKit (for voice agent)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Shopify store (auto-connect if set)
NEXT_PUBLIC_SHOPIFY_STORE_URL=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_ACCESS_TOKEN=shpat_your_access_token

# Python agent env
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_your_access_token
GOOGLE_API_KEY=your_gemini_api_key

# Shopify Catalog MCP (global product search — get from dev.shopify.com/dashboard)
SHOPIFY_CATALOG_CLIENT_ID=your_catalog_client_id
SHOPIFY_CATALOG_CLIENT_SECRET=shpss_your_catalog_secret
